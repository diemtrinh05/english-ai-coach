# ============================================================
# English AI Coach - Git line ending policy
# ============================================================

# Normalize text files in repository.
* text=auto

# Source / configuration / documentation -> LF
*.md        text eol=lf
*.txt       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.properties text eol=lf

*.java      text eol=lf
*.kt        text eol=lf
*.kts       text eol=lf
*.gradle    text eol=lf

*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf

*.dart      text eol=lf

*.py        text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf

Dockerfile  text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Windows-native scripts
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary files
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary

*.jar       binary
*.war       binary
*.zip       binary
*.7z        binary

*.apk       binary
*.aab       binary

*.jks       binary
*.keystore  binary
*.p12       binary
*.pfx       binary