# ============================================================
# 14. DATABASE / POSTGRESQL LOCAL DATA
# ============================================================

# Embedded/local DB files
*.db
*.db-journal
*.sqlite
*.sqlite3

# Local PostgreSQL persistent volumes
postgres-data/
**/postgres-data/

pgdata/
**/pgdata/

# Generic Docker persisted DB data
docker-data/
**/docker-data/

data/postgres/
**/data/postgres/

# PostgreSQL dump files generated locally
*.dump
*.backup.sql

# SQL dumps
dump.sql
database-dump.sql

# IMPORTANT:
# Do NOT ignore Flyway migration scripts.
# db/migration/*.sql must be committed.


# ============================================================
# 15. DOCKER LOCAL FILES
# ============================================================

docker-compose.override.yml
compose.override.yml

# Local Docker environment
docker/.env
**/docker/.env


# ============================================================
# 16. GENERATED SOURCE / API CLIENTS
# ============================================================

generated/
**/generated/

generated-sources/
**/generated-sources/

openapi-generated/
**/openapi-generated/

generated-client/
**/generated-client/

generated-server/
**/generated-server/

# IMPORTANT:
# Do NOT ignore authoritative API/OpenAPI files under docs/.
# The canonical OpenAPI baseline must stay committed.


# ============================================================
# 17. AI / AGENT LOCAL FILES
# ============================================================

# Local agent caches/state
.agent-cache/
**/.agent-cache/

.ai-cache/
**/.ai-cache/

.codex/
**/.codex/

.antigravity/
**/.antigravity/

# Local agent scratch/worktree files
.agent-work/
**/.agent-work/

.agent-tmp/
**/.agent-tmp/

# Do NOT ignore:
# AGENTS.md
# docs/agents/*
# PROJECT_RULES.md


# ============================================================
# 18. LOCAL DEVELOPER FILES
# ============================================================

.local/
**/.local/

*.local

.local-settings/
developer-settings.*


# ============================================================
# 19. ARCHIVES GENERATED LOCALLY
# ============================================================

# Generated project/package archives should normally not live in Git.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar


# ============================================================
# 20. PATCH / DIFF OUTPUT GENERATED LOCALLY
# ============================================================

*.patch.tmp
*.diff.tmp


# ============================================================
# 21. PERFORMANCE / PROFILING OUTPUT
# ============================================================

*.jfr
*.prof
*.profraw

profiles/
**/profiles/


# ============================================================
# 22. LOCAL HTTP/API TEST ENVIRONMENTS
# ============================================================

*.private.env.json

.http-client.env.json.local


# ============================================================
# 23. KEEP IMPORTANT REPOSITORY FILES
# ============================================================

# Explicit safeguards. These normally aren't ignored above,
# but keep the project policy obvious.

!.gitignore

!requirements-dev.txt

!.env.example
!.env.*.example

!README.md
!AGENTS.md

# Gradle wrapper
!gradlew
!gradlew.bat
!gradle/
!gradle/wrapper/
!gradle/wrapper/**

# Maven wrapper
!mvnw
!mvnw.cmd
!.mvn/
!.mvn/wrapper/
!.mvn/wrapper/**

# Node dependency lock files
!package-lock.json
!pnpm-lock.yaml
!yarn.lock

# Flutter lock file
!pubspec.lock
