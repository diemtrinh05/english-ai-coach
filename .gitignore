# ============================================================
# English AI Coach
# Root .gitignore
#
# Covers:
# - Java / Spring Boot
# - Gradle / Maven
# - PostgreSQL / Flyway
# - Android Java
# - React + TypeScript + Vite
# - Flutter / Dart (V2)
# - Python development tools
# - Docker
# - IntelliJ / Android Studio / VS Code
# - Test / coverage / build artifacts
# - Environment files / credentials / secrets
# - AI Agent local scratch/cache
# ============================================================


# ============================================================
# 1. ENVIRONMENT VARIABLES / SECRETS
# ============================================================

.env
.env.*
!.env.example
!.env.*.example

# Generic secrets
secrets/
**/secrets/

*.secret
*.secrets

# Certificates / private keys
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# Java / Android signing credentials
*.jks
*.keystore

# Cloud / service credentials
credentials.json
credentials-*.json
service-account.json
service-account-*.json
firebase-adminsdk-*.json

# Firebase Android configuration
# Inject this through local environment / CI when needed.
**/google-services.json
!**/google-services.example.json

# Local Spring configuration containing machine-specific secrets
application-local.yml
application-local.yaml
application-local.properties
**/application-local.yml
**/application-local.yaml
**/application-local.properties

# BE-FND-003 cố ý track profile local dùng chung này; file chỉ kích hoạt profile và không chứa secret.
!backend/src/main/resources/application-local.yml

# Optional external secret config
application-secret.yml
application-secret.yaml
application-secrets.yml
application-secrets.yaml
**/application-secret.yml
**/application-secret.yaml
**/application-secrets.yml
**/application-secrets.yaml


# ============================================================
# 2. PYTHON TOOLING
# ============================================================

# Virtual environments
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.coverage
.coverage.*
htmlcov/

# Python packaging
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/

# Python local environment
.python-version


# ============================================================
# 3. JAVA / SPRING BOOT
# ============================================================

*.class

# Maven build output
target/
**/target/

# Gradle build output
.gradle/
**/.gradle/
build/
**/build/

# Generic Java output
out/
**/out/

# Java crash/runtime files
hs_err_pid*
replay_pid*

# Spring runtime
spring-shell.log

# Do NOT ignore:
# gradlew
# gradlew.bat
# gradle/wrapper/*
# mvnw
# mvnw.cmd
# .mvn/wrapper/*


# ============================================================
# 4. ANDROID / ANDROID STUDIO
# ============================================================

# Machine-specific Android SDK path
local.properties
**/local.properties

# Android generated directories
.externalNativeBuild/
**/.externalNativeBuild/

.cxx/
**/.cxx/

captures/
**/captures/

.navigation/
**/.navigation/

# Android packages / build artifacts
*.apk
*.aab
*.ap_
*.dex

# Android lint generated
lint-results*.xml

# Android profiling
*.hprof

# Native build files
cmake-build-*/


# ============================================================
# 5. REACT / TYPESCRIPT / VITE / NODE.JS
# ============================================================

node_modules/
**/node_modules/

# Build output
dist/
**/dist/

# Vite
.vite/
**/.vite/

# TypeScript build cache
*.tsbuildinfo

# Test coverage
coverage/
**/coverage/

# Istanbul / NYC
.nyc_output/
**/.nyc_output/

# Package manager caches
.npm/
.yarn/cache/
.yarn/unplugged/
.pnpm-store/

# npm logs
npm-debug.log*
npm-error.log*

# Yarn logs
yarn-debug.log*
yarn-error.log*

# pnpm logs
pnpm-debug.log*

# ESLint cache
.eslintcache
**/.eslintcache

# Parcel/Webpack caches if introduced later
.parcel-cache/
.webpack-cache/

# Storybook build if introduced later
storybook-static/

# Do NOT ignore lock files:
# package-lock.json
# pnpm-lock.yaml
# yarn.lock


# ============================================================
# 6. FLUTTER / DART — FUTURE V2
# ============================================================

.dart_tool/
**/.dart_tool/

.packages

.pub/
.pub-cache/

.flutter-plugins
.flutter-plugins-dependencies

# Flutter build output is already covered by build/
# but kept explicit for clarity.
**/flutter/build/

# Generated documentation
doc/api/

# Dart coverage
**/coverage/lcov.info

# Do NOT ignore pubspec.lock for application projects.
# Flutter application should commit:
# pubspec.yaml
# pubspec.lock


